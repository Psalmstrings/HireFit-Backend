# ========================================================
# HireFit Server Environment Configuration Template
# ========================================================
PORT=5000
NODE_ENV=production

# Client Application URL (for CORS and email redirect links)
CLIENT_URL=https://hire-fitt.vercel.app

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_jwt_secret_here_min_32_chars

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hirefit?retryWrites=true&w=majority

# ========================================================
# Google Gemini AI Configuration
# ========================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ========================================================
# Resend Email Delivery (100% Free - 3,000 emails/month)
# Sign up free at: https://resend.com
# Get API key at: https://resend.com/api-keys
# ========================================================
RESEND_API_KEY=re_your_resend_api_key_here

# For testing with Resend's free sandbox domain:
# RESEND_FROM="HireFit <onboarding@resend.dev>"
#
# When you verify your domain at https://resend.com/domains:
# RESEND_FROM="HireFit Team <support@yourdomain.com>"

# ========================================================
# Gmail Nodemailer SMTP (Local / Self-hosted Fallback)
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
# ========================================================
EMAIL_USER=psalmstringsdigital@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password
EMAIL_FROM="HireFit Team <psalmstringsdigital@gmail.com>"

# ========================================================
# Cloudinary Storage (Optional - falls back to local /uploads)
# ========================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
