# ========================================================
# HireFit Server Environment Configuration Template
# ========================================================
PORT=5000
NODE_ENV=production

# Client Application URL (for CORS and email redirect links)
CLIENT_URL=https://hire-fitt.vercel.app

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_jwt_secret_here_min_32_chars

# MongoDB Database Connection
# If left empty in development, in-memory MongoDB will be used automatically.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hirefit?retryWrites=true&w=majority

# ========================================================
# Google Gemini AI Configuration (Recommended)
# ========================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ========================================================
# Gmail Nodemailer SMTP Configuration
# Create an App Password at: https://myaccount.google.com/apppasswords
# ========================================================
EMAIL_SERVICE=gmail
EMAIL_USER=psalmtringsdigital@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password
EMAIL_FROM="HireFit Team <psalmtringsdigital@gmail.com>"

# ========================================================
# Cloudinary Storage (Optional - falls back to local /uploads)
# ========================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
